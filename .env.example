# --- Discord ---------------------------------------------------------------

# Bot token (Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=

# The server cadybot watches
GUILD_ID=

# Your Discord user ID. cadybot's private channel is created for you, and only
# you can run add / remove / backfill / purge.
OWNER_ID=

# Name of the private channel cadybot creates and manages. It is the only
# channel in the server cadybot can write to.
CADYBOT_ROOM=cadybot


# --- Model backend ---------------------------------------------------------

# "ollama" for local inference, "anthropic" for Claude.
CADYBOT_BACKEND=ollama

# Local (Ollama). num_ctx must be large enough to hold the system prompt plus
# the snapshot — too small and the prompt is silently truncated.
CADYBOT_OLLAMA_HOST=http://localhost:11434
CADYBOT_OLLAMA_MODEL=gemma4:e4b
CADYBOT_OLLAMA_NUM_CTX=16384
CADYBOT_OLLAMA_TIMEOUT=600

# Claude (only used when CADYBOT_BACKEND=anthropic)
ANTHROPIC_API_KEY=
CADYBOT_MODEL=claude-opus-5


# --- Storage ---------------------------------------------------------------

CADYBOT_DB=cadybot.db

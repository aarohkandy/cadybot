# Discord application bot token (Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=

# The server cadybot watches
GUILD_ID=

# Your Discord user ID. All output goes here. Only this user can ask it things.
OWNER_ID=

# Optional: a locked staff-only channel to mirror briefs into. Leave blank for DM-only.
# This is the ONLY channel cadybot is permitted to write to.
STAFF_CHANNEL_ID=

# Anthropic API key. Leave unset if you've run `ant auth login`.
ANTHROPIC_API_KEY=

# Optional overrides
CADYBOT_DB=cadybot.db
CADYBOT_MODEL=claude-opus-5

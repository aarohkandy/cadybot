# --- Discord ---------------------------------------------------------------

# Bot token (Developer Portal -> Bot -> Reset Token). The only required value.
DISCORD_TOKEN=

# Optional. cadybot works in every server it's added to, and each one gets its
# own private channel, its own owner, and its own isolated data. These two only
# set a default for the command line so you don't have to pass --guild.
GUILD_ID=
OWNER_ID=

# Name of the private channel /private creates. It is the only channel in a
# server cadybot can write to.
CADYBOT_ROOM=cadybot


# --- Model backend ---------------------------------------------------------

# "ollama" for local inference, "anthropic" for Claude.
CADYBOT_BACKEND=ollama

# Local (Ollama). num_ctx must be large enough to hold the system prompt plus
# the snapshot — too small and the prompt is silently truncated.
CADYBOT_OLLAMA_HOST=http://localhost:11434
CADYBOT_OLLAMA_MODEL=gemma4:e4b
CADYBOT_OLLAMA_NUM_CTX=16384
CADYBOT_OLLAMA_TIMEOUT=600

# Claude (only used when CADYBOT_BACKEND=anthropic)
ANTHROPIC_API_KEY=
CADYBOT_MODEL=claude-opus-5


# --- Storage ---------------------------------------------------------------

CADYBOT_DB=cadybot.db
